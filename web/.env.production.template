# ============================================================
# WQN Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to version control.
# ============================================================

# --- ACR credentials (used by deploy.sh for docker login) ---
ACR_SERVER=crpi-xxxxxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=wqn
ACR_USERNAME=your-access-key-id
ACR_PASSWORD=your-acr-password

# --- Image tag ---
IMAGE=crpi-xxxxxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com/your-namespace/wqn:latest

# --- Docker build base image ---
# Default pulls from Docker Hub. If auth.docker.io is unreachable from your
# network, mirror node:24-alpine to ACR or another reachable registry and set
# this to the mirrored image.
BASE_NODE_IMAGE=node:24-alpine

# Optional Docker build proxy, used only by deploy/build-and-push.ps1.
WQN_BUILD_PROXY=

# Runtime port inside the Next.js container. Dockerfile defaults to 3000.
PORT=3000

# --- Supabase Configuration ---
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Site URL ---
# Used for sitemap, canonical URLs, and as the default public base URL for
# server-generated ESP32 audio callback URLs when WQN_ESP32_AI_PUBLIC_BASE_URL
# is not set.
SITE_URL=https://your-domain.com

# --- Next.js Runtime Stability ---
# Keep this stable across Docker rebuilds and all running instances. Without a
# stable key, active browser sessions can hit "Failed to find Server Action"
# after a deploy or when requests land on a different instance.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# --- Main Web AI Provider ---
# Used by the web app's wrong-question extraction, categorisation, and digest
# features. Supported AI_PROVIDER values are currently: google, anthropic,
# openai. For OpenAI-compatible providers, set AI_PROVIDER=openai and fill
# AI_PROVIDER_BASE_URL / AI_PROVIDER_API_KEY.
AI_PROVIDER=google
AI_PROVIDER_BASE_URL=https://api.example.com/v1
AI_PROVIDER_API_KEY=your_openai_compatible_api_key_here

# Google Gemini key. Required when AI_PROVIDER=google.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Web app AI model choices.
AI_MODEL_EXTRACTION=gemini-2.5-flash
AI_MODEL_CATEGORISATION=gemini-2.5-flash
AI_MODEL_DIGEST=gemini-3-flash-preview

# --- ESP32 Voice AI ---
# First-stage ESP32 flow uploads short 16 kHz s16le mono PCM clips and receives
# JSON text. Provider secrets stay on the server; never bake them into firmware.
WQN_ESP32_AI_ASR_PROVIDER=dashscope
WQN_ESP32_AI_CHAT_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_TASK_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
DASHSCOPE_TASK_STATUS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/tasks
DASHSCOPE_ASR_LANGUAGE_HINTS=zh,en
DASHSCOPE_ASR_POLL_INTERVAL_MS=800
DASHSCOPE_ASR_POLL_ATTEMPTS=45
DASHSCOPE_CHAT_MODEL=qwen-plus

# Optional system prompt for ESP32 text replies. If unset, the server uses the
# default prompt in web/lib/esp32-ai-provider.ts.
WQN_ESP32_AI_SYSTEM_PROMPT=你是 WQN 错题本设备上的学习助手。根据用户语音转写内容，用简洁中文回答，优先帮助用户学习、复习错题和安排任务。

# Provider request timeout for ESP32 ASR/chat calls.
WQN_ESP32_AI_PROVIDER_TIMEOUT_MS=60000

# Public base URL that DashScope can use to fetch temporary WAV files.
# This must be reachable from the public internet.
WQN_ESP32_AI_PUBLIC_BASE_URL=https://your-domain.com

# Long random signing secret for temporary ESP32 audio URLs.
WQN_ESP32_AI_AUDIO_URL_SECRET=replace_with_long_random_secret
WQN_ESP32_AI_AUDIO_TMP_DIR=/tmp/wqn-esp32-ai-audio
WQN_ESP32_AI_AUDIO_URL_TTL_MS=300000

# --- ESP32 AI Local/Test Only ---
# Do not enable this in production. It is only honored in NODE_ENV=test.
WQN_ESP32_AI_TRANSCRIBE_CHAT_MOCK=0
