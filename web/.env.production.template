# ============================================================
# WQN Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to version control.
# ============================================================

# --- ACR credentials (used by deploy.sh for docker login) ---
ACR_SERVER=crpi-xxxxxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=wqn
ACR_USERNAME=your-access-key-id
ACR_PASSWORD=your-acr-password

# --- Image tag ---
IMAGE=crpi-xxxxxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com/your-namespace/wqn:latest

# --- Docker build base image ---
# Default pulls from Docker Hub. If auth.docker.io is unreachable from your
# network, mirror node:24-alpine to ACR or another reachable registry and set
# this to the mirrored image.
BASE_NODE_IMAGE=node:24-alpine

# Optional Docker build proxy, used only by deploy/build-and-push.ps1.
WQN_BUILD_PROXY=

# Runtime port inside the Next.js container. Dockerfile defaults to 3000.
PORT=3000

# --- Self-hosted Supabase (data.helema.cn) ---
# Public URL and publishable key are embedded in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://data.helema.cn
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=sb_publishable_replace_me
# Startup refuses a different host when this guard is set.
WQN_SUPABASE_EXPECTED_HOST=data.helema.cn
# Keep this empty for HTTPS. To use HTTP only over a trusted private network,
# set the exact origin (no trailing slash); a boolean opt-in is intentionally
# unsupported.
WQN_ALLOW_HTTP_SUPABASE_ORIGIN=
# Preferred server-only key. Keep the legacy variable empty unless an older
# self-hosted stack has not enabled sb_secret keys yet.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ---
# Used for sitemap, canonical URLs, and as the default public base URL for
# server-generated ESP32 audio callback URLs when WQN_ESP32_AI_PUBLIC_BASE_URL
# is not set.
SITE_URL=https://wqn.helema.cn

# --- Next.js Runtime Stability ---
# Keep this stable across Docker rebuilds. The build script passes it through a
# BuildKit secret; Next.js embeds it in server-only build output, while Docker
# ARG/ENV metadata and runtime environment stay free of the key.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# --- Main Web AI Provider ---
# Used by the web app's wrong-question extraction, categorisation, and digest
# features. Supported AI_PROVIDER values are currently: google, anthropic,
# openai. For OpenAI-compatible providers, set AI_PROVIDER=openai and fill
# AI_PROVIDER_BASE_URL / AI_PROVIDER_API_KEY.
AI_PROVIDER=google
AI_PROVIDER_BASE_URL=https://api.example.com/v1
AI_PROVIDER_API_KEY=your_openai_compatible_api_key_here

# Google Gemini key. Required when AI_PROVIDER=google.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Web app AI model choices.
AI_MODEL_EXTRACTION=gemini-2.5-flash
AI_MODEL_CATEGORISATION=gemini-2.5-flash
AI_MODEL_DIGEST=gemini-3-flash-preview

# --- ESP32 Voice AI ---
# First-stage ESP32 flow uploads short 16 kHz s16le mono PCM clips and receives
# JSON text. Provider secrets stay on the server; never bake them into firmware.
# Primary STD/Pro ASR provider: "dashscope" or "stepfun".
WQN_ESP32_AI_ASR_PROVIDER=dashscope
# Optional fallback: "none", "dashscope", or "stepfun". It must differ from
# the primary provider. Fallback is attempted only for provider/transport ASR
# failures (including timeout and rate limit), never for no_speech/invalid_audio.
WQN_ESP32_AI_ASR_FALLBACK_PROVIDER=none
WQN_ESP32_AI_CHAT_PROVIDER=dashscope
# DashScope API Key for ASR (and Chat if DASHSCOPE_CHAT_API_KEY is unset)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional separate API keys for the Chat models per tier. If using third-party OpenAI-compatible
# APIs for chat, set their API keys here. They fall back to DASHSCOPE_API_KEY if unset.
# DASHSCOPE_CHAT_API_KEY_STD=your_third_party_chat_api_key_std
# DASHSCOPE_CHAT_API_KEY_PRO=your_third_party_chat_api_key_pro
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_TASK_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
DASHSCOPE_TASK_STATUS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/tasks
DASHSCOPE_ASR_LANGUAGE_HINTS=zh,en
DASHSCOPE_ASR_POLL_INTERVAL_MS=800
DASHSCOPE_ASR_POLL_ATTEMPTS=45

# StepFun one-shot ASR for STD/Pro (stepaudio-2.5-asr). Required whenever
# primary or fallback selects "stepfun". This key is intentionally independent
# from STEP_API_KEY used by the Flash realtime proxy; there is no key fallback.
STEPFUN_API_KEY=your_stepfun_api_key_here
STEPFUN_ASR_URL=https://api.stepfun.com/v1/audio/asr/sse
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_ASR_LANGUAGE=zh
# Optional hot words (comma-separated) to boost recognition accuracy.
# STEPFUN_ASR_HOTWORDS=错题,单词,笔记本
# Inverse Text Normalization (digit/punctuation normalization). Default true.
# STEPFUN_ASR_ENABLE_ITN=true
DASHSCOPE_CHAT_MODEL=qwen-plus

# Per-tier chat model overrides for ESP32 AI voice chat.
# STD tier uses the standard model (falls back to DASHSCOPE_CHAT_MODEL if unset).
# Pro tier uses the premium model (falls back to qwen-max if unset).
DASHSCOPE_CHAT_MODEL_STD=qwen-plus
DASHSCOPE_CHAT_MODEL_PRO=qwen-max

# Per-tier OpenAI-compatible base URL overrides for ESP32 AI voice chat.
# STD tier base URL (falls back to DASHSCOPE_OPENAI_BASE_URL if unset).
# Pro tier base URL (falls back to DASHSCOPE_OPENAI_BASE_URL if unset).
# DASHSCOPE_OPENAI_BASE_URL_STD=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_OPENAI_BASE_URL_PRO=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional system prompt for ESP32 text replies. If unset, the server uses the
# default prompt in web/lib/esp32-ai-provider.ts.
WQN_ESP32_AI_SYSTEM_PROMPT=你是 WQN 错题本设备上的学习助手。根据用户语音转写内容，用简洁中文回答，优先帮助用户学习、复习错题和安排任务。

# Provider request timeout for ESP32 ASR/chat calls.
WQN_ESP32_AI_PROVIDER_TIMEOUT_MS=60000

# Public base URL that DashScope can use to fetch temporary WAV files.
# This must be reachable from the public internet.
WQN_ESP32_AI_PUBLIC_BASE_URL=https://your-domain.com

# Long random signing secret for temporary ESP32 audio URLs.
WQN_ESP32_AI_AUDIO_URL_SECRET=replace_with_long_random_secret
WQN_ESP32_AI_AUDIO_TMP_DIR=/tmp/wqn-esp32-ai-audio
WQN_ESP32_AI_AUDIO_URL_TTL_MS=300000

# --- ESP32 AI Local/Test Only ---
# Do not enable this in production. It is only honored in NODE_ENV=test.
WQN_ESP32_AI_TRANSCRIBE_CHAT_MOCK=0

# =========================================================================
# ESP32 AI v2 Streaming + Flash Realtime
# =========================================================================
# Add this block to .env.production. Everything defaults to a safe / off
# state so the v1 one-shot path keeps working until the new route is live.

# --- Protocol switch ---
# `auto` (default) routes by X-WQN-Protocol / ?protocol=...; `v2` forces
# v2-streaming for everyone. `v1` locks the route to the legacy one-shot
# JSON response. The auth-verify path is independent.
WQN_ESP32_AI_STREAMING_MODE=auto

# --- SSE streaming tunables (POST /api/esp32/ai/transcribe-chat?protocol=v2-streaming) ---
# How long the SSE connection stays open at most (ms). Server closes the stream
# when the model is done or this timeout fires, whichever comes first.
WQN_ESP32_AI_STREAM_TIMEOUT_MS=240000
# ASR poll cadence inside the SSE stream (ms). The legacy 800 ms default works
# but the streaming UI doesn't need ASR to finish — keep parity for now.
WQN_ESP32_AI_STREAM_ASR_POLL_INTERVAL_MS=800
# Hard cap on tool calls per turn. Reject after this with model_failed.
WQN_ESP32_AI_STREAM_MAX_TOOLS_PER_TURN=8
# Event-id counter start; should be unique across restarts to keep Last-Event-ID
# recovery sane. Default 0.
WQN_ESP32_AI_STREAM_EVENT_ID_BASE=0
# Cache TTL (hours) for SSE final-frame idempotency keyed by X-WQN-Request-Id.
WQN_ESP32_AI_STREAM_REQUEST_CACHE_HOURS=24
# If you put a Redis URL here, final-frame idempotency uses Redis; otherwise
# the route uses an in-memory LRU. Required for multi-instance Next.js deploys.
# WQN_ESP32_AI_STREAM_REDIS_URL=redis://127.0.0.1:6379/0

# --- Flash Realtime v2 (wss://wqn.helema.cn/api/esp32/realtime) ---
# Bearer token used only by the Flash realtime proxy for StepFun realtime
# audio. It is never used as the STD/Pro STEPFUN_API_KEY fallback and is never
# exposed to the device.
STEP_API_KEY=replace_with_stepfun_api_key
# Realtime model id (must match Sec-WebSocket-Protocol wqn-flash-v2).
STEP_TTS_MODEL=stepaudio-2.5-realtime
# Upstream WS endpoint for StepFun Realtime. Default is what platform.stepfun.ai
# documents as of 2026-07; pin if you run a mirror.
STEP_TTS_REALTIME_URL=wss://api.stepfun.ai/v1/realtime/audio
# Fallback for situations where Realtime is unreachable; we degrade to a
# one-shot TTS call.
STEP_TTS_HTTP_URL=https://api.stepfun.ai/v1/audio/speech
# Default voice and sample rate negotiated in session.update.
STEP_TTS_DEFAULT_VOICE=qingchunshaonv
STEP_TTS_DEFAULT_SAMPLE_RATE=24000

# --- Internal auth between wqn-realtime (Bun) and wqn-app (Next.js) ---
# Long random secret shared by both containers. The Bun relay sends it as
# `X-WQN-Realtime-Auth` on every request to wqn-app's execute-tool endpoint.
# Generate with: openssl rand -hex 32
WQN_REALTIME_PROXY_SECRET=replace_with_long_random_secret
# Internal base URL the Bun relay uses to call back into Next.js.
# On the same host (compose network): http://wqn:3000
# Standalone containers: http://127.0.0.1:3000
WQN_INTERNAL_API_BASE=http://wqn:3000
WQN_INTERNAL_API_ALLOWED_HOST=wqn:3000

# Where the Flash proxy listens internally. nginx proxies the public WS path
# to this port. Should NOT be exposed to the internet directly.
WQN_FLASH_PROXY_BIND=0.0.0.0
WQN_FLASH_PROXY_PORT=8080
WQN_FLASH_PROXY_PATH=/api/esp32/realtime

# Allowed voice IDs (csv). Anything outside this list is rejected at session.update.
WQN_FLASH_ALLOWED_VOICES=qingchunshaonv,cixingnansheng
# Server VAD defaults negotiated if the client doesn't override.
WQN_FLASH_VAD_PREFIX_PADDING_MS=500
WQN_FLASH_VAD_SILENCE_DURATION_MS=200
WQN_FLASH_VAD_THRESHOLD=0.5
# Max audio per turn (ms) — once exceeded the server force-commits.
WQN_FLASH_MAX_AUDIO_MS=20000
# Idle timeout (s): how long an open Flash WS can sit without audio before the
# proxy pings the client and (if still silent) closes with code 1011.
WQN_FLASH_IDLE_TIMEOUT_S=120
# How many concurrent WS connections a single device may hold. Excess gets
# closed with 4029 rate_limited.
WQN_FLASH_MAX_CONCURRENT_PER_DEVICE=2

# --- Flash Realtime rate limiting (uses web/lib/rate-limit.ts) ---
WQN_RATE_LIMIT_REALTIME_DEVICE_WINDOW_MS=60000
WQN_RATE_LIMIT_REALTIME_DEVICE_MAX=6

# --- Flash Realtime persistence ---
# flash_session_id TTL (days). Server drops the row after this and forces the
# device to start a new session on next connect.
WQN_FLASH_SESSION_TTL_DAYS=30

# --- Shared WS / Realtime telemetry ---
# Sentry / OpenTelemetry DSN for the Flash proxy. Same key as the Next.js app
# if you use a single project. Leave blank to disable.
# SENTRY_DSN_REALTIME=

# --- Feature flags ---
# Master switch for the Flash v2 proxy. When false, /api/esp32/realtime returns
# 503 disabled. Use this to kill the Realtime path without redeploying.
WQN_AI_REALTIME_ENABLED=true
# When true, the v2 SSE path is enabled alongside v1. When false, the route
# always returns v1 JSON regardless of X-WQN-Protocol.
WQN_AI_STREAMING_ENABLED=true

# --- New device-table fields (run the migration before flipping) ---
# Mirrors the migration in 12-cloud-side-tasks.md §⑦.
# WQN_ESP32_DEVICES_PREFERRED_TIER_DEFAULT=std
