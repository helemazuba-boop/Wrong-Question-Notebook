    "smoke:m7-cutover": "node ../deploy/supabase-selfhost/m7-cutover-smoke.mjs",
    "check-all": "npm run type-check && npm run lint && npm run format:check",
    "fix-all": "npm run lint:fix && npm run format",
    "prepare": "cd .. && husky web/.husky",
    "prepush": "npm run fix-all && npm run check-all && npm run test && npm run build && npm run check:client-bundle-secrets"
