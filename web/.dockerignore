# Dependencies
/node_modules/
**/node_modules/

# Next.js build artifacts
.next/
out/
build/

# Git
.git
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment and secrets never enter the Docker build context. The only
# build-time values are the explicit public ARGs declared by Dockerfile.
.env
.env.*
.env.local
.env.development
.env.test

# Test & coverage
coverage/
*.test.ts
*.test.tsx
vitest.config.ts

# Dev config not needed at runtime
.eslintrc*
.prettierrc*
eslint.config.mjs
components.json
vite.config.ts

# Documentation
*.md
!README.md

# Supabase local dev (not needed at runtime)
supabase/

# Husky
.husky/

# Scripts (dev helper only)
scripts/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Temporary
.turbo/
.cache/
