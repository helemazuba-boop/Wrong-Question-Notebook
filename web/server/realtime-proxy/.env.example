# ===========================================================================
# WQN Flash Realtime Relay — environment template
# Copy to .env, fill in, and `bun start`.
# This server must NEVER be reachable from the public internet. It authenticates
# the device Bearer token before creating a relay session.
# ===========================================================================

# --- Server bind ---
WQN_FLASH_PROXY_BIND=0.0.0.0
WQN_FLASH_PROXY_PORT=8080

# --- StepFun Realtime upstream ---
# Bearer token used by WQN to talk to StepFun's Realtime. Server side only.
STEP_API_KEY=replace_with_stepfun_api_key
# Real StepFun Realtime model id. ESP32 sends "wqn-flash-v2" which the proxy
# replaces with this before forwarding upstream.
STEP_TTS_MODEL=stepaudio-2.5-realtime
STEP_TTS_REALTIME_URL=wss://api.stepfun.com/v1/realtime

# --- Supabase (for device auth + flash_session persistence) ---
SUPABASE_URL=https://data.helema.cn
WQN_SUPABASE_EXPECTED_HOST=data.helema.cn
# Exact private HTTP origin only; leave empty for HTTPS.
WQN_ALLOW_HTTP_SUPABASE_ORIGIN=
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# --- Master switch ---
# When false, /api/esp32/realtime returns 503 disabled.
WQN_AI_REALTIME_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
