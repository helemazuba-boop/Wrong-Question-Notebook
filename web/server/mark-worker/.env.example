# App and worker must use the same engine and independent marking credential.
PROBLEM_MARKING_ENGINE=agent
PROBLEM_MARKING_AGENT_SECRET=replace-with-at-least-32-random-characters
WQN_MARK_APP_URL=http://wqn:3000
# OpenCode V2 server; the worker intentionally omits model selection.
WQN_MARK_OPENCODE_URL=http://opencode-mark:4096
WQN_MARK_OPENCODE_DIRECTORY=/srv/wqn-mark/registry
WQN_MARK_OPENCODE_USERNAME=opencode
WQN_MARK_OPENCODE_PASSWORD=replace-with-opencode-server-password
WQN_MARK_CONCURRENCY=2
# Used by the OpenCode workspace configuration, not the worker.
WQN_MARK_MCP_URL=https://wqn.example.com/api/mcp/mark
