FROM node:24-alpine
WORKDIR /app
RUN addgroup -S -g 1001 wqn && adduser -S -u 1001 -G wqn wqn
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --chown=wqn:wqn server/mark-worker /app/server/mark-worker
USER wqn
ENV NODE_ENV=production PORT=8090
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 CMD wget -qO- http://127.0.0.1:8090/health || exit 1
CMD ["node", "server/mark-worker/main.mjs"]
