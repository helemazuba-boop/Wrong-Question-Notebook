<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- OkHttp 5 contributes this provider to the test APK. AGP puts the
             shared startup classes in the target APK, so AndroidX Test's
             independently launched helper activities cannot load it. The
             instrumentation process already initializes OkHttp lazily. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>
