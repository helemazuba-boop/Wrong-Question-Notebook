<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge is enabled in code; bars are transparent and the WebView
         container is inset via WindowInsets (the site has no viewport-fit=cover). -->
    <style name="Theme.Wqn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
