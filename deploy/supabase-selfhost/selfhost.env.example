# Overlay for the official Supabase self-hosted Docker stack.
# Generate every secret independently; never commit the populated file.
POSTGRES_PASSWORD=replace_with_random_database_password
JWT_SECRET=replace_with_at_least_32_random_characters
ANON_KEY=replace_with_generated_legacy_anon_key
SERVICE_ROLE_KEY=replace_with_generated_legacy_service_role_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

SUPABASE_PUBLIC_URL=https://data.helema.cn
API_EXTERNAL_URL=https://data.helema.cn/auth/v1
SITE_URL=https://wqn.helema.cn
ADDITIONAL_REDIRECT_URLS=https://wqn.helema.cn/auth/callback

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=replace_with_admin_email
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_SENDER_NAME=WQN

DASHBOARD_USERNAME=replace_with_studio_username
DASHBOARD_PASSWORD=replace_with_random_studio_password
SECRET_KEY_BASE=replace_with_at_least_64_random_characters
VAULT_ENC_KEY=replace_with_exactly_32_random_characters

# Kong must only be reachable through OpenResty on the same host.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
